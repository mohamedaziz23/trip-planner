# Server
PORT=4000
NODE_ENV=development
# Public URL of this API (used to build local upload URLs)
API_PUBLIC_URL=http://localhost:4000
# Origin of the deployed front end (CORS is restricted to it)
CLIENT_ORIGIN=http://localhost:3000

# MongoDB (a replica set is needed for transactions: docker-compose starts one)
MONGODB_URI=mongodb://127.0.0.1:27017/trip-planner?directConnection=true

# JWT secrets - use long random values in production
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Cookie settings for the refresh token. When the front end proxies /api through
# Next.js (default setup) the cookie is first-party, so lax + not secure is fine locally.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Cloudinary (optional - files are stored on disk under ./uploads when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push - generate with `npm run vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tripplanner.local

# SMTP (optional - when empty, password reset links are printed in the API console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Trip Planner <no-reply@tripplanner.local>

# Exchange rates (no key needed). Rates are fetched once a day and cached in memory.
RATES_API_URL=https://open.er-api.com/v6/latest
# Routing between stops (OSRM). Falls back to a straight-line estimate when unreachable.
OSRM_URL=https://router.project-osrm.org
# Geocoding (Nominatim)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Seed: administrator account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@tripplanner.local
SEED_ADMIN_PASSWORD=Admin12345!
